# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string. Works with Neon, Supabase, Railway, or any Postgres host.
DATABASE_URL="postgresql://user:password@host:5432/balora?schema=public"

# ── Auth (NextAuth) ───────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── Payments: Paystack (supports Ghana Mobile Money + Cards) ─
# Get these from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"

# ── Images: Cloudinary ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Transactional email: Resend ───────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Balora Bags <orders@balorabags.com>"

# ── Business / WhatsApp ───────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="233540784922"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── First admin bootstrap (development only) ──────────────
# Used once by `npm run db:seed` to create the first admin account.
# You MUST change this password on first login in production.
SEED_ADMIN_EMAIL="admin@balorabags.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
